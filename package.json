{
  "name": "qualitydashboard",
  "engines": {
    "node": "12.x"
  },
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build; cp ./dist/index.html ./dist/404.html",
    "lint": "vue-cli-service lint",
    "start": "http-server ./dist"
  },
  "dependencies": {
    "core-js": "^3.6.5",
    "http-server": "^14.1.1",
    "node-fetch": "^2.6.1",
    "numeral": "^2.0.6",
    "vue": "^2.6.11",
    "vue-numeral-filter": "^2.2.0",
    "vue-plotly": "^1.1.0",
    "vue-router": "^3.5.1",
    "vue-select": "^3.20.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "node-sass": "^6.0.0",
    "sass-loader": "^10",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
